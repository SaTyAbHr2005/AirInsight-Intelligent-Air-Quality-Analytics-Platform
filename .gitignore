# Standard Gitignore for Full-Stack App Deployments

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Python / Backend
backend/__pycache__/
backend/*.pyc
backend/*.pyo
backend/*.pyd
backend/venv/
backend/env/
backend/.venv/
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/

# CatBoost & Research Artifacts
**/catboost_info/
**/__pycache__/
graphs/*.png
backend/models/*.pkl
backend/models/*.joblib
backend/models/*.bst
backend/models/*.json

# Data & Datasets
datasets/
data/
*.tsv
*.csv
*.xlsx
*.zip

# Environment & Secrets
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# IDE & System
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
build_error.txt
node_modules/
dist/
