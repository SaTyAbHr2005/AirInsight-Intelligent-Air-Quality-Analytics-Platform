# Copy to .env and fill in.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=airinsight

SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# Bootstrap admin created when an empty database is seeded
ADMIN_USERNAME=admin1
ADMIN_PASSWORD=admin123
ALLOW_ADMIN_SIGNUP=true

# Comma-separated origins allowed to call the API (* for any)
CORS_ORIGINS=*
# Minutes between automatic sensor check-ins
TICK_MINUTES=15

# Air assistant: Gemini first, Groq as backup, built-in rules if both are missing or down
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
